    { "id": "app-04", "site": "app-landing", "type": "multi", "question": "What's the difference between the Free and Pro plans?",
      "expected": { "action": "answer", "answer": "Free: up to 3 projects, basic analytics, community support. Pro ($4.99/month): unlimited projects, advanced analytics, priority support, cloud sync & backup, early access.", "evidence": [{ "text": "Up to 3 projects", "match": "Up to 3 projects" }, { "text": "Unlimited projects", "match": "Unlimited projects" }] } },
    { "id": "app-05", "site": "app-landing", "type": "lookup", "question": "Which platforms are supported?",
