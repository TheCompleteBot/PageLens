    { "id": "app-06", "site": "app-landing", "type": "vocab", "question": "Does it work without internet?",
      "expected": { "action": "answer", "answer": "Yes, core features work fully offline and sync when you reconnect.", "evidence": [{ "text": "Core features work fully offline…", "match": "work fully offline" }] } },
    { "id": "app-07", "site": "app-landing", "type": "lookup", "question": "How do I restore my purchases?",
      "expected": { "action": "answer", "answer": "Settings → Subscription → Restore Purchases, signed in with the same account.", "evidence": [{ "text": "Open the app, go to Settings → Subscription, and tap Restore Purchases…", "match": "Restore Purchases" }] } },
    { "id": "app-08", "site": "app-landing", "type": "lookup", "question": "What is the app's rating?",
      "expected": { "action": "answer", "answer": "4.8, from 1.2K ratings.", "evidence": [{ "text": "4.8 · 1.2K ratings", "match": "4.8" }] } },
    { "id": "app-09", "site": "app-landing", "type": "lookup", "question": "What version is the app on?",
      "expected": { "action": "answer", "answer": "Version 1.0.0, updated Jan 10, 2026.", "evidence": [{ "text": "Version 1.0.0", "match": "1.0.0" }] } },
    { "id": "app-10", "site": "app-landing", "type": "compute", "question": "How much would the Pro plan cost for a whole year?",
      "expected": { "action": "answer", "answer": "$4.99 × 12 = $59.88 a year.", "evidence": [{ "text": "$4.99 /month", "match": "$4.99" }] } },
    { "id": "app-11", "site": "app-landing", "type": "navigate", "question": "Where can I download the app?",
      "expected": { "action": "highlight", "match": "found", "evidence": [{ "text": "Download on the App Store", "match": "App Store", "tag": "a" }] },
      "alternatives": [{ "action": "highlight", "match": "found", "evidence": [{ "text": "Get it on Google Play", "match": "Google Play", "tag": "a" }] }] },
    { "id": "app-12", "site": "app-landing", "type": "navigate", "question": "I want to talk to your sales team",
      "expected": { "action": "highlight", "match": "found", "evidence": [{ "text": "Contact Sales", "match": "Contact Sales" }] } },
    { "id": "app-13", "site": "app-landing", "type": "lookup", "question": "How quickly does support reply?",
      "expected": { "action": "answer", "answer": "Within 24 hours on business days.", "evidence": [{ "text": "We respond within 24 hours on business days.", "match": "24 hours" }] } },
    { "id": "app-14", "site": "app-landing", "type": "absent", "question": "Is there a student discount?",
      "expected": { "action": "abstain" } },
    { "id": "app-15", "site": "app-landing", "type": "absent", "question": "Who is the CEO of the company?",
      "expected": { "action": "abstain" } },
