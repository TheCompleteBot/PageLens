{
  "name": "PageLens fresh-site set v1",
  "created": "2026-10-20",
  "purpose": "Three open-source sites from domains never used for development or tuning (restaurant, app landing page, blog). Questions were written from the page content before running the system on them. Measure only; do not tune against this set.",
  "sites": {
    "restaurant": { "url": "http://127.0.0.1:5175/", "scroll": true },
    "app-landing": { "url": "http://localhost:3001/", "scroll": true },
    "blog": "http://localhost:3002/",
    "restaurant-noscroll": "http://127.0.0.1:5175/",
    "app-landing-noscroll": "http://localhost:3001/"
  },
  "format": "Same as tests/testset.json. Sites with \"scroll\": true are scrolled through once after loading (as a visitor would), because their content fades in on scroll and is invisible (opacity 0) until then. The -noscroll sites repeat a few questions without scrolling, to measure that limitation.",
  "cases": [
    { "id": "rest-01", "site": "restaurant", "type": "lookup", "question": "What are your opening hours on Saturday?",
      "expected": { "action": "answer", "answer": "Friday and Saturday: 5:00 PM - 11:00 PM.", "evidence": [{ "text": "Fri-Sat: 5:00 PM - 11:00 PM", "match": "11:00 PM" }] } },
    { "id": "rest-02", "site": "restaurant", "type": "lookup", "question": "When are you open on Sundays?",
      "expected": { "action": "answer", "answer": "Sunday: 5:00 PM - 9:00 PM.", "evidence": [{ "text": "Sunday: 5:00 PM - 9:00 PM", "match": "9:00 PM" }] } },
    { "id": "rest-03", "site": "restaurant", "type": "lookup", "question": "Where is the restaurant located?",
      "expected": { "action": "answer", "answer": "123 Culinary Avenue, New York, NY 10001.", "evidence": [{ "text": "123 Culinary Avenue", "match": "123 Culinary Avenue" }, { "text": "New York, NY 10001", "match": "New York, NY 10001" }] } },
    { "id": "rest-04", "site": "restaurant", "type": "lookup", "question": "When was RestoOne founded?",
      "expected": { "action": "answer", "answer": "In 2018.", "evidence": [{ "text": "Founded in 2018, RestoOne has been a beacon of culinary excellence…", "match": "Founded in 2018" }] } },
    { "id": "rest-05", "site": "restaurant", "type": "lookup", "question": "Who is the head chef?",
      "expected": { "action": "answer", "answer": "Aarav Kapoor, Head Chef & Owner.", "evidence": [{ "text": "Aarav Kapoor · Head Chef & Owner", "match": "Head Chef & Owner" }] } },
    { "id": "rest-06", "site": "restaurant", "type": "vocab", "question": "Who makes the desserts?",
      "expected": { "action": "answer", "answer": "Sloane Harper, the Pastry Chef, trained in Paris.", "evidence": [{ "text": "Sloane Harper · Pastry Chef", "match": "Pastry Chef" }] } },
    { "id": "rest-07", "site": "restaurant", "type": "lookup", "question": "Has the restaurant won any awards?",
      "expected": { "action": "answer", "answer": "Yes: Best Fine Dining 2023.", "evidence": [{ "text": "Award Winning · Best Fine Dining 2023", "match": "Best Fine Dining 2023" }] } },
    { "id": "rest-08", "site": "restaurant", "type": "multi", "question": "How many signature dishes and happy customers do you have?",
      "expected": { "action": "answer", "answer": "50+ signature dishes and 10K+ happy customers.", "evidence": [{ "text": "50+ Signature Dishes", "match": "50+" }, { "text": "10K+ Happy Customers", "match": "10K+" }] } },
    { "id": "rest-09", "site": "restaurant", "type": "navigate", "question": "I want to book a table",
      "expected": { "action": "highlight", "match": "found", "evidence": [{ "text": "Make Reservation", "match": "Make Reservation" }] } },
    { "id": "rest-10", "site": "restaurant", "type": "navigate", "question": "Show me the chefs",
      "expected": { "action": "highlight", "match": "found", "evidence": [{ "text": "Meet Our Chefs (section)", "match": "Meet Our Chefs" }] },
      "alternatives": [{ "action": "highlight", "match": "found", "evidence": [{ "text": "Chefs (nav button)", "match": "Chefs", "exact": true }] },
        { "action": "highlight", "match": "found", "evidence": [{ "text": "Aarav Kapoor", "match": "Aarav Kapoor" }] }] },
    { "id": "rest-11", "site": "restaurant", "type": "vocab", "question": "Which chef cooks Asian food?",
      "expected": { "action": "answer", "answer": "Diego Montoya, the Sous Chef, specializes in Asian fusion.", "evidence": [{ "text": "Diego specializes in Asian fusion…", "match": "Asian fusion" }] } },
    { "id": "rest-12", "site": "restaurant", "type": "compute", "question": "How many hours are you open on Fridays?",
      "expected": { "action": "answer", "answer": "From 5:00 PM to 11:00 PM: 6 hours.", "evidence": [{ "text": "Fri-Sat: 5:00 PM - 11:00 PM", "match": "11:00 PM" }] } },
    { "id": "rest-13", "site": "restaurant", "type": "absent", "question": "Do you have vegan options?",
      "note": "No menu items are on the page; a Menu button exists.",
      "expected": { "action": "abstain" },
      "alternatives": [{ "action": "highlight", "match": "maybe", "evidence": [{ "text": "Menu / Explore Menu button", "match": "Menu" }] }] },
    { "id": "rest-14", "site": "restaurant", "type": "absent", "question": "Do you offer home delivery?",
      "expected": { "action": "abstain" } },
    { "id": "rest-15", "site": "restaurant", "type": "absent", "question": "How much is a three-course dinner?",
      "note": "No prices on the page.",
      "expected": { "action": "abstain" },
      "alternatives": [{ "action": "highlight", "match": "maybe", "evidence": [{ "text": "Menu / Explore Menu button", "match": "Menu" }] }] },
    { "id": "rest-16", "site": "restaurant", "type": "pii", "question": "What is your phone number?",
      "note": "Shown on the page, redacted for the AI. Pointing to it is right; stating it is impossible.",
      "expected": { "action": "highlight", "match": "found", "evidence": [{ "text": "([phone] in Contact", "match": "[phone]" }] },
      "alternatives": [{ "action": "answer", "evidence": [{ "text": "([phone] in Contact", "match": "[phone]" }] }, { "action": "abstain" }] },

    { "id": "app-01", "site": "app-landing", "type": "lookup", "question": "How much does the Pro plan cost?",
      "expected": { "action": "answer", "answer": "$4.99 per month.", "evidence": [{ "text": "$4.99 /month", "match": "$4.99" }] } },
    { "id": "app-02", "site": "app-landing", "type": "lookup", "question": "Is there a free plan?",
      "expected": { "action": "answer", "answer": "Yes, the Free plan is $0/month, no credit card required.", "evidence": [{ "text": "Free · $0 /month", "match": "$0" }] } },
    { "id": "app-03", "site": "app-landing", "type": "lookup", "question": "What does the Teams plan cost?",
